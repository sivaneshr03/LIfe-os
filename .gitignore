# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnp/
.pnp.js

# ─── Environment Variables & Secrets ─────────────────────────────────────────
# Never commit secrets — use .env.example as a safe template instead
.env
.env.*
!.env.example
.dev.vars

# ─── Build Outputs ────────────────────────────────────────────────────────────
dist/
dist-ssr/
build/
.output/
.vite/
*.local

# ─── Cloudflare / Wrangler Local State ───────────────────────────────────────
# Contains local D1 SQLite data, KV state, temp bundles — never commit
.wrangler/

# ─── Local Database Files ─────────────────────────────────────────────────────
*.sqlite
*.sqlite-journal
*.sqlite3
*.db
backups/

# ─── Logs & Debug Output ──────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.eslintcache

# ─── Agent / IDE Session Artifacts ───────────────────────────────────────────
# Includes LLM transcripts, debug runtime cache, API usage logs
# (Curated skills in .agents/skills/*.md are safe to commit)
.system_generated/

# ─── OS & System Files ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── IDE & Editor Caches ─────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
