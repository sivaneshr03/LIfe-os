# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnp/
.pnp.js

# ─── Environment Variables & Secrets ─────────────────────────────────────────
# Never commit secrets — use templates as safe examples
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example

# ─── Build Outputs ────────────────────────────────────────────────────────────
dist/
dist-ssr/
build/
.output/
.vite/
*.local
*.tsbuildinfo

# ─── Cloudflare / Wrangler Local State ───────────────────────────────────────
# Contains local D1 SQLite data, KV state, temp bundles — never commit
.wrangler/

# ─── Local Database Files & Exports ──────────────────────────────────────────
*.sqlite
*.sqlite-journal
*.sqlite3
*.db
backups/
*backup*.sql
*.dump.sql
export*.sql
*.sql.gz

# ─── Logs & Test Outputs ─────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.eslintcache
coverage/
.vitest/

# ─── Agent / IDE Session Artifacts ───────────────────────────────────────────
# Includes LLM transcripts, debug runtime cache, API usage logs
# (Curated skills in .agents/skills/*.md are safe to commit)
.system_generated/

# ─── OS & System Files ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# ─── IDE & Editor Caches ─────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.tmp
