{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lifeos-app",
  "main": "src/server/index.ts",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lifeos-db-local",
      "database_id": "local-lifeos-db-id",
      "migrations_dir": "./drizzle"
    }
  ],
  "vars": {
    "ENVIRONMENT": "local",
    "APP_NAME": "LifeOS",
    "LOG_LEVEL": "debug"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "env": {
    "preview": {
      "name": "lifeos-app-preview",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lifeos-d1-preview",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "./drizzle"
        }
      ],
      "vars": {
        "ENVIRONMENT": "preview",
        "APP_NAME": "LifeOS (Preview)",
        "LOG_LEVEL": "info"
      }
    },
    "production": {
      "name": "lifeos-app-production",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lifeos-d1-prod",
          "database_id": "00000000-0000-0000-0000-000000000002",
          "migrations_dir": "./drizzle"
        }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "APP_NAME": "LifeOS",
        "LOG_LEVEL": "warn"
      }
    }
  }
}
