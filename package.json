{
  "name": "lifeos",
  "version": "0.1.0",
  "description": "LifeOS - Edge-native personal productivity and life-management web application",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:client": "vite",
    "dev:server": "wrangler dev",
    "dev:all": "node scripts/dev.js",
    "build": "vite build",
    "build:client": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply lifeos-db-local --local",
    "skill": "node scripts/skills-manager.js",
    "skill:list": "node scripts/skills-manager.js list",
    "skill:search": "node scripts/skills-manager.js search",
    "skill:categories": "node scripts/skills-manager.js categories",
    "skill:help": "node scripts/skills-manager.js help"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.39.3",
    "hono": "^4.7.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@eslint/js": "^9.20.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.4",
    "eslint": "^9.20.1",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "wrangler": "^3.109.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
